[Unit]
Description=AIW Next.js standalone server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aiw
Group=aiw
WorkingDirectory=/srv/aiw/current
EnvironmentFile=/etc/aiw/production.env
Environment=NODE_ENV=production
Environment=HOSTNAME=localhost
Environment=PORT=5180
ExecStart=/usr/bin/env node --dns-result-order=ipv4first server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
